+#[derive(Debug, Clone)]
+struct PendingExplorerOpen {
+    request_id: String,
+    work_dir: PathBuf,
+    source: String,
+}
+
+fn pending_explorer_opens() -> &'static Mutex<VecDeque<PendingExplorerOpen>> {
+    static PENDING: OnceLock<Mutex<VecDeque<PendingExplorerOpen>>> = OnceLock::new();
+    PENDING.get_or_init(|| Mutex::new(VecDeque::new()))
+}
+
+pub fn open_workspace_session_from_explorer(
+    app: &AppHandle,
+    work_dir: &Path,
+    source: &str,
+    request_id: &str,
+) -> Result<(), String> {
+    let request = PendingExplorerOpen {
+        request_id: request_id.to_string(),
+        work_dir: normalize_path(work_dir),
+        source: source.to_string(),
+    };
+
+    if runtime_api_ready(app).unwrap_or(false) {
+        spawn_explorer_session(app.clone(), request);
+        return Ok(());
+    }
+
+    pending_explorer_opens()
+        .lock()
+        .map_err(|_| "pending Explorer open queue mutex is poisoned".to_string())?
+        .push_back(request);
+    Ok(())
+}
+
+fn spawn_explorer_session(app: AppHandle, request: PendingExplorerOpen) {
+    thread::spawn(move || {
+        match create_workspace_session_for_grid(&app, &request.work_dir) {
+            Ok(session) => {
+                let payload = WorkspaceSessionBridgePayload {
+                    action: "navigate_session".to_string(),
+                    source: request.source.clone(),
+                    request_id: Some(request.request_id),
+                    session_id: Some(session.session_id),
+                    work_dir: session.work_dir,
+                    route_template: None,
+                    disposition: Some(WorkspaceSessionDisposition::NewPane),
+                    target_window_label: Some(window_manager::MAIN_WINDOW_LABEL.to_string()),
+                    applied: None,
+                    reason: None,
+                };
+                // One canonical event. Do not emit the same new-pane command twice.
+                emit_workspace_session_event(&app, WORKSPACE_SESSION_BRIDGE_EVENT, &payload);
+                window_manager::show_and_focus(&app);
+            }
+            Err(error) => emit_bootstrap_open_request_error(
+                &app,
+                &request.source,
+                "create_workspace_session_for_grid",
+                &format!("{}", error),
+            ),
+        }
+    });
+}
