{
  "name": "appskimi-shell",
  "description": "KickSide desktop workspace for Kimi Code and DeepSeek Harness.",
  "private": true,
  "version": "0.2.3",
  "packageManager": "pnpm@10.34.4",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/endearqb/kickside.git"
  },
  "type": "module",
  "scripts": {
    "sync:version": "node scripts/sync_version.mjs",
    "version:bump:patch": "node scripts/bump_patch_version.mjs",
    "dev": "pnpm sync:version && vite",
    "build": "pnpm sync:version && tsc && vite build",
    "build:bridge-sidecar": "node scripts/build_bridge_sidecar.mjs",
    "clean:public-build-artifacts": "powershell -ExecutionPolicy Bypass -File scripts/clean_public_build_artifacts.ps1",
    "preview": "vite preview",
    "test": "vitest run",
    "check:kimi-web:visual": "node scripts/check_kimi_web_layout_visual.mjs",
    "verify": "pnpm sync:version && .\\node_modules\\.bin\\tsc.cmd --noEmit && pnpm test && pnpm check:nfr:security",
    "tauri": "pnpm sync:version && tauri",
    "tauri:build:macos:local": "pnpm sync:version && tauri build --target aarch64-apple-darwin --bundles app --config src-tauri/tauri.macos.local.conf.json",
    "tauri:build:webview:evergreen": "powershell -ExecutionPolicy Bypass -File scripts/build_webview_variant.ps1 -Variant evergreen",
    "tauri:build:webview:fixed": "powershell -ExecutionPolicy Bypass -File scripts/build_webview_variant.ps1 -Variant fixed",
    "verify:public-artifacts:no-abs-paths": "powershell -ExecutionPolicy Bypass -File scripts/verify_public_artifacts_no_abs_paths.ps1",
    "verify:tracked-markdown:no-abs-paths": "powershell -ExecutionPolicy Bypass -File scripts/verify_tracked_markdown_no_abs_paths.ps1",
    "sync:kimi-web": "powershell -ExecutionPolicy Bypass -File scripts/sync_kimi_cli_web.ps1",
    "check:enhanced-web:i18n": "node scripts/check_enhanced_web_i18n.mjs",
    "check:enhanced-web:compliance": "node scripts/check_enhanced_web_compliance.mjs",
    "check:nfr:security": "node scripts/check_capabilities.mjs && node scripts/check_bundle_resources.mjs && node scripts/check_command_registry.mjs",
    "check:dsh:runtime": "node scripts/dsh_runtime_smoke.mjs --version 0.1.0-rc.7",
    "check:nfr:port-conflict": "powershell -ExecutionPolicy Bypass -File scripts/nfr_port_conflict.ps1",
    "check:nfr:reliability": "powershell -ExecutionPolicy Bypass -File scripts/nfr_reliability.ps1"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.561.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.5.2",
    "jsdom": "^24.1.3",
    "postcss": "^8.5.16",
    "tailwindcss": "3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.9"
  }
}
