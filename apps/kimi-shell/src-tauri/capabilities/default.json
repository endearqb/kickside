{
  "$schema": "../gen/schemas/desktop-schema.json",
  "capabilities": [
    {
      "identifier": "default",
      "description": "Capability for the main window",
      "local": true,
      "windows": ["main"],
      "permissions": [
        "core:default",
        "core:webview:allow-create-webview",
        "core:webview:allow-create-webview-window",
        "core:webview:allow-set-webview-focus",
        "core:webview:allow-set-webview-position",
        "core:webview:allow-set-webview-size",
        "core:webview:allow-webview-close",
        "dialog:allow-open",
        "main-command-access"
      ]
    },
    {
      "identifier": "prefill",
      "description": "Capability for the prefill window",
      "local": true,
      "windows": ["prefill"],
      "permissions": ["core:default", "prefill-command-access"]
    },
    {
      "identifier": "workspace-import-picker",
      "description": "Capability for the workspace import picker window",
      "local": true,
      "windows": ["workspace-import-picker"],
      "permissions": [
        "core:default",
        "dialog:allow-open",
        "workspace-import-command-access"
      ]
    },
    {
      "identifier": "agent-room",
      "description": "Capability for the Agent Room window",
      "local": true,
      "windows": ["agent-room"],
      "permissions": [
        "core:default",
        "core:window:allow-is-always-on-top",
        "core:window:allow-set-always-on-top",
        "agent-room-command-access"
      ]
    },
    {
      "identifier": "frameless-window-controls",
      "description": "Windows-only permissions required by the custom titlebar controls.",
      "local": true,
      "platforms": ["windows"],
      "windows": ["main", "prefill", "workspace-import-picker", "agent-room"],
      "permissions": [
        "core:window:allow-start-dragging",
        "core:window:allow-minimize",
        "core:window:allow-toggle-maximize",
        "core:window:allow-close",
        "core:window:allow-is-maximized"
      ]
    }
  ]
}
