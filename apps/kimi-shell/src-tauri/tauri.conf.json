{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kimi Desktop Shell",
  "version": "0.0.9",
  "identifier": "com.kimi.shell",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kimi Desktop Shell",
        "url": "prefill.html",
        "create": false,
        "visible": false,
        "center": true,
        "width": 720,
        "height": 420,
        "minWidth": 660,
        "minHeight": 380,
        "decorations": false,
        "transparent": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
