{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kimi sidekick",
  "version": "0.1.22",
  "identifier": "com.kimi.shell",
  "build": {
    "beforeDevCommand": "pnpm build:bridge-sidecar -- --profile debug && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build && pnpm build:bridge-sidecar",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "prefill",
        "title": "kimi sidekick",
        "url": "prefill.html",
        "create": false,
        "visible": false,
        "center": true,
        "width": 720,
        "height": 520,
        "minWidth": 660,
        "minHeight": 460,
        "decorations": false,
        "transparent": false,
        "shadow": true
      },
      {
        "label": "main",
        "title": "kimi sidekick",
        "url": "index.html#/loading",
        "create": false,
        "visible": false,
        "center": true,
        "width": 1200,
        "height": 820,
        "minWidth": 900,
        "minHeight": 640,
        "decorations": false,
        "transparent": false,
        "shadow": true
      },
      {
        "label": "workspace-import-picker",
        "title": "选择目标工作区",
        "url": "index.html#/workspace-import-picker",
        "create": false,
        "visible": false,
        "center": true,
        "width": 720,
        "height": 560,
        "minWidth": 680,
        "minHeight": 520,
        "resizable": false,
        "decorations": false,
        "transparent": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob: https: http://127.0.0.1:* http://localhost:*; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:* http://localhost:* ws://localhost:* https: wss:; frame-src http://127.0.0.1:* http://localhost:* https:; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/kimi-im-bridge"
    ],
    "resources": {
      "harnesses/": "harnesses/",
      "../../../skills/docx/": "skills/docx/",
      "../../../skills/pdf/": "skills/pdf/",
      "../../../skills/pptx/": "skills/pptx/",
      "../../../skills/xlsx/": "skills/xlsx/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMxMjM2OTc5QzVCQjI4MEEKUldRS0tMdkZlV2tqd1NROUhCeWE2SUFSQWZKdnF2MlJCL2lLSjRlaG5LTURnQUVoUWpOa0xKeHcK",
      "endpoints": [
        "https://github.com/endearqb/kimi-app/releases/latest/download/latest.json"
      ]
    }
  }
}
